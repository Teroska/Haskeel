<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="sql-practice-01.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2073"/><column_width id="4" width="0"/><expanded_item id="1" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="students" custom_title="0" dock_id="1" table="4,8:mainstudents"/><dock_state state="000000ff00000000fd0000000100000002000003b40000030afc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000003b40000012e00ffffff000002790000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="185"/><column index="2" value="263"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="students" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="2" mode="0"/></sort><column_widths><column index="1" value="35"/><column index="2" value="244"/><column index="3" value="80"/><column index="4" value="46"/><column index="5" value="69"/><column index="6" value="59"/><column index="7" value="72"/><column index="8" value="87"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE students (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    full_name TEXT NOT NULL,
    group_name TEXT NOT NULL,
    course INTEGER CHECK (course BETWEEN 1 AND 4),
    avg_grade NUMERIC CHECK (avg_grade &gt;= 0 AND avg_grade &lt;= 100),
    is_active INTEGER CHECK (is_active IN (0, 1)),
    scholarship NUMERIC DEFAULT 0,
    enrolled_year INTEGER
);

INSERT INTO students (full_name, group_name, course, avg_grade, is_active, scholarship, enrolled_year) VALUES
('Шевченко Тарас', 'ІПЗ-11', 1, 95.5, 1, 2000, 2025),
('Коваленко Олена', 'ІПЗ-11', 1, 58.0, 1, 0, 2025),
('Бойко Андрій', 'ІПЗ-21', 2, 82.0, 1, 1500, 2024),
('Ткаченко Ірина', 'ІПЗ-21', 2, 75.0, 1, 1000, 2024),
('Лисенко Максим', 'ІПЗ-21', 2, 88.5, 1, 1500, 2024),
('Мельник Анна', 'ІПЗ-31', 3, 92.0, 1, 2000, 2023),
('Кравченко Олег', 'ІПЗ-31', 3, 65.0, 0, 0, 2023),
('Мороз Дмитро', 'ІПЗ-11', 1, 45.0, 0, 0, 2025),
('Павленко Вікторія', 'ІПЗ-21', 2, 91.0, 1, 2000, 2024),
('Сидоренко Петро', 'ІПЗ-31', 3, 79.5, 1, 1000, 2023),
('Григоренко Софія', 'ІПЗ-31', 3, 85.0, 1, 1500, 2023),
('Марченко Ігор', 'ІПЗ-11', 1, 62.0, 1, 0, 2025),
('Зайцев Володимир', 'ІПЗ-21', 2, 55.0, 1, 0, 2024),
('Козак Юлія', 'ІПЗ-31', 3, 98.0, 1, 2000, 2023),
('Бондаренко Надія', 'ІПЗ-21', 2, 72.0, 0, 0, 2024);

SELECT * FROM students;
SELECT full_name, group_name, avg_grade FROM students;
SELECT DISTINCT group_name FROM students;

SELECT * FROM students WHERE group_name = 'ІПЗ-21';
SELECT * FROM students WHERE avg_grade &gt;= 80;
SELECT * FROM students WHERE avg_grade &gt;= 60 AND avg_grade &lt;= 80;
SELECT * FROM students WHERE NOT is_active = 1; 
SELECT * FROM students WHERE course = 2 AND avg_grade &gt; 85;
SELECT * FROM students WHERE scholarship &gt; 0;
SELECT * FROM students WHERE enrolled_year = 2024;
SELECT * FROM students WHERE full_name LIKE '%енко%';

SELECT * FROM students ORDER BY avg_grade DESC;
SELECT * FROM students ORDER BY full_name ASC;
SELECT * FROM students 
WHERE group_name = 'ІПЗ-21' 
ORDER BY avg_grade DESC;
SELECT * FROM students ORDER BY group_name ASC, full_name ASC;
SELECT * FROM students 
WHERE course = 3 
ORDER BY scholarship DESC, avg_grade DESC;

SELECT * FROM students 
WHERE is_active = 1 AND avg_grade &gt;= 90 
ORDER BY avg_grade DESC, full_name ASC;
SELECT * FROM students 
WHERE scholarship = 0 AND avg_grade &gt;= 75;
SELECT * FROM students 
WHERE (course = 1 OR course = 2) AND avg_grade &lt; 60 
ORDER BY avg_grade ASC;
SELECT * FROM students 
WHERE group_name = 'ІПЗ-31' AND enrolled_year &gt; 2022 
ORDER BY enrolled_year DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
